{:deps {org.clojure/clojure {:mvn/version "1.12.6"}}
 :paths ["src"]
 :aliases {:dev {:extra-paths ["dev"]
                 :extra-deps  {com.datomic/local {:mvn/version "1.0.301"}}
                 :jvm-opts    [;; https://www.metosin.fi/blog/missing-stacktraces
                               "-XX:-OmitStackTraceInFastThrow"]}
           :outdated {:deps      {com.github.liquidz/antq {:mvn/version "RELEASE"}
                                  org.slf4j/slf4j-nop     {:mvn/version "2.0.20"}}
                      :main-opts ["-m" "antq.core"]}
           :test {:extra-paths ["test" "test-resources"]
                  :extra-deps  {backtick/backtick          {:mvn/version "0.4.0"}
                                com.datomic/local          {:mvn/version "1.0.301"}
                                nubank/matcher-combinators {:mvn/version "3.11.0"}}
                  :jvm-opts    ["-XX:-OmitStackTraceInFastThrow"]}
           :test-runner {:extra-deps {io.github.cognitect-labs/test-runner {:git/sha "dfb30dd" :git/tag "v0.5.1"}}
                         :main-opts  ["-m" "cognitect.test-runner"]
                         :exec-fn    cognitect.test-runner.api/test}}}
